# --- Core -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Public short-link domain without scheme.
SHORT_DOMAIN=localhost:8000
# Absolute origin for links in emails. Set explicitly in production; defaults to https://SHORT_DOMAIN.
# SITE_URL=https://sho.rt
# Number of reverse proxies in front of the app that append to X-Forwarded-For;
# 0 = trust REMOTE_ADDR only.
TRUSTED_PROXY_HOPS=1
# Path segment for the Django admin (https://<host>/<ADMIN_URL_PATH>/).
ADMIN_URL_PATH=admin
# Magic link request rate limits: N links per email per email-window seconds,
# and N links per IP per ip-window seconds.
MAGIC_LINK_RATE_PER_EMAIL=3
MAGIC_LINK_RATE_PER_EMAIL_WINDOW=600
MAGIC_LINK_RATE_PER_IP=20
MAGIC_LINK_RATE_PER_IP_WINDOW=3600
# Workspace invitation rate limits: N invitations per workspace per
# workspace-window seconds, and N invitations per inviting user per user-window
# seconds.
INVITE_RATE_PER_WORKSPACE=20
INVITE_RATE_PER_WORKSPACE_WINDOW=3600
INVITE_RATE_PER_USER=30
INVITE_RATE_PER_USER_WINDOW=3600
# Slug availability check rate limit: N checks per user per window seconds.
SLUG_CHECK_RATE=60
SLUG_CHECK_RATE_WINDOW=60

# --- Data stores --------------------------------------------------------
# Local (compose.dev.yaml):
DATABASE_URL=postgres://short:short@localhost:5432/short
CACHE_URL=redis://localhost:6379/0
# Production example (PgBouncer + TLS Redis):
# DATABASE_URL=postgresql://short_app:PASSWORD@db.example.com:5432/short?sslmode=verify-full
# CACHE_URL=rediss://short:PASSWORD@redis.example.com:6379/0

# --- Background tasks ---------------------------------------------------
# The backend is chosen by the settings module: dev/test default to
# django.tasks.backends.immediate.ImmediateBackend, prod defaults to
# django_tasks_db.backend.DatabaseBackend. Set TASKS_BACKEND only to override
# that default.
# TASKS_BACKEND=django.tasks.backends.immediate.ImmediateBackend

# --- Email --------------------------------------------------------------
# consolemail:// prints to stdout (dev quick start only). Production refuses
# the console backend and requires a real mail server, e.g.:
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=short <no-reply@example.com>

# --- Links ---------------------------------------------------------------
# Generated short code length.
# LINK_CODE_LENGTH=7
# Comma-separated hosts that may never be used as a destination (subdomains included).
# BLOCKED_LINK_DOMAINS=bad.example,phishing.example
# LINK_RATE_PER_USER=30
# LINK_RATE_PER_USER_WINDOW=60
# LINK_RATE_PER_WORKSPACE=300
# LINK_RATE_PER_WORKSPACE_WINDOW=3600
# Short-code availability check rate limit: N checks per user per window seconds.
# LINK_CODE_CHECK_RATE=60
# LINK_CODE_CHECK_RATE_WINDOW=60
# Metadata fetch limits for the destination's title, favicon and Open Graph tags.
# LINK_METADATA_TIMEOUT=5.0
# LINK_METADATA_MAX_BYTES=2097152
# Overall wall-clock budget for a metadata fetch, across every redirect hop.
# LINK_METADATA_TOTAL_TIMEOUT=10.0
# Maximum redirect hops a metadata fetch will follow before giving up.
# LINK_METADATA_MAX_REDIRECTS=3
# Budget (seconds) for resolving a single host during a metadata fetch, counted
# against LINK_METADATA_TOTAL_TIMEOUT.
# LINK_METADATA_DNS_TIMEOUT=2.0
# Metadata lookup rate limits: N lookups per user per window seconds, and N lookups
# per workspace per window seconds.
# LINK_METADATA_RATE=20
# LINK_METADATA_RATE_WINDOW=60
# LINK_METADATA_RATE_PER_WORKSPACE=60
# LINK_METADATA_RATE_PER_WORKSPACE_WINDOW=60
# How long a resolved short link stays in the cache, and how long an unknown code is
# remembered as missing so scans do not reach the database.
# REDIRECT_CACHE_TTL=3600
# REDIRECT_MISS_TTL=60
# How long the deep link page waits for the app before falling back to the web URL.
# DEEP_LINK_FALLBACK_MS=1500
# Redirect path rate limit: N requests per IP per window seconds, enforced in
# apps.redirects.middleware before a code is resolved.
# REDIRECT_RATE_PER_IP=20
# REDIRECT_RATE_PER_IP_WINDOW=1

# --- Analytics ------------------------------------------------------------
# How long ClickEvent rows are kept before the retention purge task removes them.
# CLICK_EVENT_RETENTION_DAYS=90
# How many rows the nightly purge task deletes per batch.
# ANALYTICS_PURGE_BATCH_SIZE=5000
# Path to a GeoLite2 City .mmdb file, for resolving click country/city. Optional and
# empty by default: without it the app runs normally and clicks carry no geography.
# Download your own free copy from MaxMind (a free account is required) and never
# commit it; see docs/self-hosting.md.
# GEOIP_PATH=/data/GeoLite2-City.mmdb

# --- Production only ----------------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://sho.rt
# SECURE_SSL_REDIRECT=true
# SENTRY_DSN=
# MEDIA_ROOT defaults to /data/media in production (BASE_DIR/media elsewhere).
# MEDIA_ROOT=/data/media
LOG_LEVEL=INFO
